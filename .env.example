# Robot Battery Monitor — environment variables
# Copy to .env:  cp .env.example .env

# --- PostgreSQL ---
# Dev-only credentials. Change POSTGRES_PASSWORD for anything beyond your laptop
# (and update DATABASE_URL below to match).
POSTGRES_USER=robot
POSTGRES_PASSWORD=robot
POSTGRES_DB=robot_battery
POSTGRES_PORT=5432

# --- Dashboard ---
DASHBOARD_PORT=5000
# Bind address when running run_dashboard.py directly (default 127.0.0.1).
# docker-compose forces 0.0.0.0 inside the container; the host port stays 127.0.0.1-only.
# DASHBOARD_HOST=127.0.0.1
# Extra browser origins for SocketIO (comma list). Default: http://127.0.0.1:5000,http://localhost:5000
# RBM_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# --- API token (optional, recommended) ---
# When set, every POST/PUT/PATCH/DELETE needs header X-API-Token: <value>.
# Webots controller and scripts/*.py send it automatically from this env var
# (the Webots controller also reads it from this .env file).
# Browser: open http://127.0.0.1:5000/?token=<value> once to unlock the controls.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
RBM_API_TOKEN=
DATABASE_URL=postgresql://robot:robot@postgres:5432/robot_battery

# --- Hardware mode ---
# simulator | real
HARDWARE_MODE=real
# generic | ros2
HARDWARE_TYPE=ros2
# true = built-in mock pub/sub (no rclpy required in dashboard container)
ROS2_MOCK=true

# --- ROS2 (shared DDS domain for dashboard + ros2-sim) ---
ROS_DOMAIN_ID=0
ROS2_START_DELAY=10
ROS2_SIM_INTERVAL=5

# --- Logging ---
LOG_LEVEL=INFO

# --- Database wait (container startup) ---
DB_WAIT_ATTEMPTS=30
DB_WAIT_INTERVAL=2