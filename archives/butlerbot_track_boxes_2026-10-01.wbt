#VRML_SIM R2025a utf8
# ARCHIVE ONLY - not loaded by any world.
# Legacy S-track paint from webots/worlds/butlerbot.wbt as of 2026-10-01
# (before the single-mesh DEF TRACK Pose): 105 top-level Transform+Box nodes
# (2 bars + 98 lane-line boxes 0.38 x 0.06 x 0.01 every 0.34 m + 5 ticks).
# Regenerate with scripts/s_track.py emit_vrml_boxes(). To restore, paste
# these nodes back in place of the "DEF TRACK Pose" block (they are top-level
# nodes, place them before "Robot {").
# =============================================================================
# Gentle S-curve track (visual only - no boundingObject)
# Start (0,0)  first lobe SIGN=-1  finish 16.5
# Amplitude 1 m  min radius ~1.3 m  last 3.5 m straight
# Same yellow / red recipe as the old straight. Edges follow path normals.
# =============================================================================

# START line (green)
Transform {
  translation 0.0000 0.0000 0.015
  rotation 0 0 1 0.00000
  children [
    Shape {
        appearance PBRAppearance {
          baseColor 0.1 0.85 0.25
          roughness 0.7
          metalness 0
          emissiveColor 0.05 0.2 0.05
        }
      geometry Box {
        size 0.080 1.400 0.020
      }
    }
  ]
}
# FINISH line (red) - GPS (16.5, 0)
Transform {
  translation 16.5000 0.0000 0.015
  rotation 0 0 1 0.00000
  children [
    Shape {
        appearance PBRAppearance {
          baseColor 0.9 0.15 0.12
          roughness 0.7
          metalness 0
          emissiveColor 0.25 0.04 0.03
        }
      geometry Box {
        size 0.080 1.400 0.020
      }
    }
  ]
}

