#VRML_SIM R2025a utf8

# Apartment twin of Dan's Halcyon Castle Hills plan A2 (1 bed, 1 bath).
# Next ButlerBot course after the warehouse. The warehouse world,
# controllers, and energy model are not modified.
# No lane paint and no track file. This course is for vision and SLAM later.
# STEER_TRACK off
# A launch must not steer from the S-course waypoints.
# With no track tag the finish referee stays the built-in S rule
# (GPS x >= 16.5 m), which this apartment never reaches.
#
# NO FORESIGHT. Geometry here is what the sensors can see. The inch
# measurements, furniture poses, and floor plan are scoring ground truth
# and are not written into this file as a lookup table. The controller
# must map from its own sensors.
#
# Frame: ENU, Z up. +X from the bedroom's left wall toward the living
# room's right wall. +Y from the kitchen back wall toward the patio wall.
# Origin: interior corner of the bedroom left wall and the back wall.
# The front door opens into an entry hall of open floor along the east
# face of the laundry, closets, and walk-in. That hall runs north to
# door G and is open to the kitchen and living room on its east side.
# The wall on the east of the left block is the west side of the entry
# hall. It has an opening into the west hallway, and door G at the top.
# Door G is an open doorway. The leaf swings toward the kitchen and is
# not a solid in the opening. From the bath, an open walkway leads north
# into the bedroom, just right of a closed linen nook.
# The bath is the full-height west column. The middle column, top to
# bottom, is the walk-in, two closed closets, the west hallway, and the
# laundry. The walk-in opens off the bath. Door H opens from the west
# hallway into the bath. The laundry door opens off that hallway.
# Closet doors and the linen nook are closed.
# Front and patio doors are closed. Patio beyond the stop is out of scope.
# No dining table. No rug. No pendant lights.
# Bathroom, closet, laundry, pantry, storage, the linen nook, the halls,
# wall thickness, wall height, and every furniture size and position are
# estimates. Carpet lip at the bedroom openings is an estimate. Floor
# contact materials are laminate and carpet. Energy model is not wired
# to them. Carpet forceDependentSlip is higher than laminate
# (rolling-resistance stand-in).

EXTERNPROTO "../protos/ButlerBot.proto"

WorldInfo {
  basicTimeStep 8
  # Same solver as the other ButlerBot worlds (cylinder wheels on a floor).
  ERP 0.6
  CFM 1e-9
  coordinateSystem "ENU"
  contactProperties [
    # Drive hubs on grey-brown laminate. Same mu / slip as drive_wheel
    # against "default" on butlerbot_warehouse.wbt (mu=8, FDS=0.01).
    # Documented rolling resistance for a later energy hookup: Crr 0.012.
    ContactProperties {
      material1 "drive_wheel"
      material2 "laminate"
      coulombFriction [
        8
      ]
      forceDependentSlip [
        0.01
      ]
      frictionRotation 0 0
      bounce 0
      softCFM 1e-6
      softERP 0.7
    }
    # Drive hubs on medium-pile bedroom carpet. Higher forceDependentSlip
    # stands in for higher rolling resistance. Documented Crr 0.050.
    # Not read by src/twin_energy_cruise.py.
    ContactProperties {
      material1 "drive_wheel"
      material2 "carpet"
      coulombFriction [
        8
      ]
      forceDependentSlip [
        0.04
      ]
      frictionRotation 0 0
      bounce 0
      softCFM 1e-6
      softERP 0.7
    }
    ContactProperties {
      material1 "caster"
      material2 "laminate"
      coulombFriction [
        0.08
      ]
      forceDependentSlip [
        1
      ]
      bounce 0
      softCFM 1e-5
      softERP 0.5
    }
    # Casters scrub a little harder on carpet than on laminate.
    ContactProperties {
      material1 "caster"
      material2 "carpet"
      coulombFriction [
        0.15
      ]
      forceDependentSlip [
        0.6
      ]
      bounce 0
      softCFM 1e-5
      softERP 0.5
    }
    # Drive hubs against anything still on the default material
    # (walls, furniture). Copied from the warehouse world.
    ContactProperties {
      material1 "drive_wheel"
      material2 "default"
      coulombFriction [
        8
      ]
      forceDependentSlip [
        0.01
      ]
      frictionRotation 0 0
      bounce 0
      softCFM 1e-6
      softERP 0.7
    }
    ContactProperties {
      material1 "caster"
      material2 "default"
      coulombFriction [
        0.08
      ]
      forceDependentSlip [
        1
      ]
      bounce 0
      softCFM 1e-5
      softERP 0.5
    }
    ContactProperties {
      coulombFriction [
        40
      ]
      forceDependentSlip [
        0
      ]
      bounce 0
      softCFM 1e-6
      softERP 0.6
    }
  ]
  info [
    "ButlerBot apartment twin — Halcyon Castle Hills plan A2, 1 bed 1 bath"
    "Furniture sizes and positions are estimates. The controller maps from its sensors."
    "No track, no lane paint. Warehouse remains the regression course."
    "Floors: contactMaterial laminate / carpet. Energy model is not wired to them."
  ]
}

DEF VIEWPOINT Viewpoint {
  # Top-down follow, same idea as the warehouse cam, low enough to read rooms.
  follow "ButlerBot"
  followType "Tracking Shot"
  followSmoothness 0.2
  orientation 0 1 0 1.5708
  position 0 0 14
  fieldOfView 0.75
  near 0.2
  far 50
}

Background {
  skyColor 0.72 0.76 0.82
}

# Indoor fill. Shadows off so the greige walls do not black out the floor.
DirectionalLight {
  direction 0.2 -0.3 -1
  intensity 1.0
  castShadows FALSE
}
DirectionalLight {
  direction -0.35 0.45 -1
  intensity 0.55
  castShadows FALSE
}

