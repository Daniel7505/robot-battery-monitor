    # Shoulder nadirs only. LINE / SIDE / FINISH / Z/W and aim pucks
    # archived at archives/butlerbot_choir_2026-09-02.wbt.
    # Left shoulder. Boom + box from Daniel's 2026-08-25 framing (DUMP_CAM,
    # VIEWPOINT COPY position 0.01042 0.41808 0.72919). Since 2026-10-01
    # NADIR_CAM_L sits in this box (front-bottom edge), see the Camera node.
    DEF NADIR_BOOM_L Transform {
      translation 0.00521 0.26904 0.57460
      rotation 1 0 0 -0.767
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.08 0.08 0.1
            roughness 0.45
          }
          geometry Cylinder {
            height 0.43
            radius 0.012
            subdivision 8
          }
        }
      ]
    }
    DEF NADIR_BOX_L Transform {
      translation 0.01042 0.41808 0.72919
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.12 0.12 0.14
            roughness 0.4
          }
          geometry Box {
            size 0.05 0.05 0.05
          }
        }
      ]
    }
    DEF NADIR_CAM_L Camera {
      # Lens on the front-bottom edge of NADIR_BOX_L (box centre
      # 0.01042 0.41808 0.72919, 0.05 m cube): the box is behind/above the
      # lens, so no ray can see its inside. Pure pitch 0 1 0 0.9411 rad
      # (53.9 deg down) from scripts/aim_camera.py: top row -> 1.96 m ahead
      # of the axle (same reach as the old z 1.31 mount), bottom row
      # ~0.06 m ahead. Controller reads this pose live (Supervisor).
      # Keep a direct Robot child. Do not File-Save.
      translation 0.03542 0.41808 0.70419
      rotation 0 1 0 0.9411
      name "nadir_left"
      width 128
      height 128
      fieldOfView 1.2
      near 0.03
    }
    # Right shoulder: Y-mirror of the left boom/box/camera.
    DEF NADIR_BOOM_R Transform {
      translation 0.00521 -0.26904 0.57460
      rotation 1 0 0 0.767
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.08 0.08 0.1
            roughness 0.45
          }
          geometry Cylinder {
            height 0.43
            radius 0.012
            subdivision 8
          }
