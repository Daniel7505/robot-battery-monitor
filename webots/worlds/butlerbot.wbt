Robot {
  # Spawn ON the start line (x=0), lane center y=0, facing +x (toward finish)
  translation 0 0 0
  rotation 0 0 1 0
  name "ButlerBot"
  # Supervisor enables soft grip coupling (body vel ↔ wheel odo) for tire fidelity
  supervisor TRUE
  controller "butlerbot_controller"
  controllerArgs [
    "--dashboard-url=http://127.0.0.1:5000"
  ]
  customData "ButlerBot Neo — upright wheeled humanoid ~0.95m"
  children [
    DEF PELVIS_VIS Transform {
      translation 0 0 0.20
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.14 0.15 0.18
            roughness 0.45
            metalness 0.25
          }
          geometry Box {
            size 0.18 0.11 0.07
          }
        }
      ]
    }
    DEF LEFT_WHEEL_JOINT HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0.17 0.08
        # Low viscous damping for free-roll traction. High damping (was 6.5) forced
        # τ≈damping*ω through the tire contact every step → continuous slip
        # (body GPS crawl while encoders held 5.5 rad/s). Residual spin after turns
        # is killed by ABS hard-zero / dual-hub lock, not joint viscous drag.
        dampingConstant 0.15
      }
      device [
        RotationalMotor {
          name "left_wheel"
          maxVelocity 15
          # Pololu 37D 50:1 stall ≈ 2.06 N·m; slight margin for ABS hold
          maxTorque 2.5
        }
        PositionSensor {
          name "left_wheel_sensor"
        }
      ]
      endPoint Solid {
        name "left_wheel_solid"
        translation 0 0.17 0.08
        contactMaterial "drive_wheel"
        children [
          Pose {
            rotation 1 0 0 1.5708
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.08 0.08 0.1
                }
                geometry Cylinder {
                  height 0.05
                  radius 0.08
                }
              }
            ]
          }
        ]
        # ENU Cylinder stands on Z (can / puck). Hinge is Y. Same 90° about X
        # on visual AND collision so the axle rolls. 4.5 rotated the Shape only.
        boundingObject Pose {
          rotation 1 0 0 1.5708
          children [
            Cylinder {
              height 0.05
              radius 0.08
            }
          ]
        }
        physics Physics {
          density -1
          # 80 mm rubber tire+hub ≈ 0.085 kg (profile geometry.wheel_mass_kg)
          mass 0.085
          centerOfMass [
            0 0 0
          ]
          inertiaMatrix [
            1.4e-04 2.7e-04 1.4e-04
            0 0 0
          ]
        }
      }
    }
    DEF RIGHT_WHEEL_JOINT HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 -0.17 0.08
        dampingConstant 0.15
      }
      device [
        RotationalMotor {
          name "right_wheel"
          maxVelocity 15
          maxTorque 2.5
        }
        PositionSensor {
          name "right_wheel_sensor"
        }
      ]
      endPoint Solid {
        name "right_wheel_solid"
        translation 0 -0.17 0.08
        contactMaterial "drive_wheel"
        children [
          Pose {
            rotation 1 0 0 1.5708
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.08 0.08 0.1
                }
                geometry Cylinder {
                  height 0.05
                  radius 0.08
                }
              }
            ]
          }
        ]
        # ENU Cylinder stands on Z (can / puck). Hinge is Y. Same 90° about X
        # on visual AND collision so the axle rolls. 4.5 rotated the Shape only.
        boundingObject Pose {
          rotation 1 0 0 1.5708
          children [
            Cylinder {
              height 0.05
              radius 0.08
            }
          ]
        }
        physics Physics {
          density -1
          mass 0.085
          centerOfMass [
            0 0 0
          ]
          inertiaMatrix [
            1.4e-04 2.7e-04 1.4e-04
            0 0 0
          ]
        }
      }
    }
    # Catch spheres. subdivision 4 = smoother contact (2 was a faceted bump).
    # z=0.044 → bottom ~4 mm above wheel contact. At 0.04 they fight the hubs.
    DEF FRONT_LEFT_CASTER BallJoint {
      jointParameters BallJointParameters {
        anchor 0.11 0.13 0.044
        dampingConstant 0.8
      }
      endPoint Solid {
        name "front_left_caster"
        translation 0.11 0.13 0.044
        contactMaterial "caster"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.22 0.22 0.25
              roughness 0.55
            }
            geometry Sphere {
              radius 0.04
              subdivision 4
            }
          }
        ]
        boundingObject Sphere {
          radius 0.04
          subdivision 4
        }
        physics Physics {
          density -1
          mass 0.06
        }
      }
    }
    DEF FRONT_RIGHT_CASTER BallJoint {
      jointParameters BallJointParameters {
        anchor 0.11 -0.13 0.044
        dampingConstant 0.8
      }
      endPoint Solid {
        name "front_right_caster"
        translation 0.11 -0.13 0.044
        contactMaterial "caster"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.22 0.22 0.25
              roughness 0.55
            }
            geometry Sphere {
              radius 0.04
              subdivision 4
            }
          }
        ]
        boundingObject Sphere {
          radius 0.04
          subdivision 4
        }
        physics Physics {
          density -1
          mass 0.06
        }
      }
    }
    DEF REAR_LEFT_CASTER BallJoint {
      jointParameters BallJointParameters {
        anchor -0.11 0.13 0.044
        dampingConstant 0.8
      }
      endPoint Solid {
        name "rear_left_caster"
        translation -0.11 0.13 0.044
        contactMaterial "caster"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.22 0.22 0.25
              roughness 0.55
            }
            geometry Sphere {
              radius 0.04
              subdivision 4
            }
          }
        ]
        boundingObject Sphere {
          radius 0.04
          subdivision 4
        }
        physics Physics {
          density -1
          mass 0.06
        }
      }
    }
    DEF REAR_RIGHT_CASTER BallJoint {
      jointParameters BallJointParameters {
        anchor -0.11 -0.13 0.044
        dampingConstant 0.8
      }
      endPoint Solid {
        name "rear_right_caster"
        translation -0.11 -0.13 0.044
        contactMaterial "caster"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.22 0.22 0.25
              roughness 0.55
            }
            geometry Sphere {
              radius 0.04
              subdivision 4
            }
          }
        ]
        boundingObject Sphere {
          radius 0.04
          subdivision 4
        }
        physics Physics {
          density -1
          mass 0.06
        }
      }
    }

    DEF TORSO_JOINT HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0 0.24
        dampingConstant 18.0
      }
      device [
        RotationalMotor {
          name "torso_joint"
          maxVelocity 0.7
          maxTorque 6.0
        }
        PositionSensor {
          name "torso_sensor"
        }
      ]
      endPoint Solid {
        name "torso_solid"
        translation 0 0 0.24
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.2 0.34 0.48
              roughness 0.5
              metalness 0.15
            }
            geometry Box {
              size 0.17 0.14 0.34
            }
          }
          Transform {
            translation 0 0.12 0.08
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.38 0.39 0.42
                }
                geometry Box {
                  size 0.05 0.05 0.04
                }
              }
            ]
          }
          Transform {
            translation 0 -0.12 0.08
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.38 0.39 0.42
                }
                geometry Box {
                  size 0.05 0.05 0.04
                }
              }
            ]
          }
          DEF NECK_VIS Transform {
            translation 0 0 0.20
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.18 0.2 0.24
                }
                geometry Cylinder {
                  height 0.06
                  radius 0.035
                }
              }
            ]
          }
          DEF HEAD_VIS Transform {
            translation 0 0 0.38
            children [
              GPS {
                name "gps_head"
                accuracy 0
                resolution -1
              }
              Shape {
                appearance PBRAppearance {
                  baseColor 0.16 0.18 0.22
                  roughness 0.35
                  metalness 0.2
                }
                geometry Sphere {
                  radius 0.065
                }
              }
              Transform {
                translation 0 0.065 0.01
                rotation 0 0 1 0
                children [
                  Shape {
                    appearance PBRAppearance {
                      baseColor 0.05 0.55 0.75
                      emissiveColor 0.02 0.15 0.22
                    }
                    geometry Box {
                      size 0.025 0.07 0.03
                    }
                  }
                ]
              }
            ]
          }
          DEF LEFT_ARM_JOINT HingeJoint {
            jointParameters HingeJointParameters {
              axis 0 1 0
              anchor 0 0.11 0.10
              dampingConstant 10.0
            }
            device [
              RotationalMotor {
                name "left_arm"
                maxVelocity 1.0
                maxTorque 4.0
              }
              PositionSensor {
                name "left_arm_sensor"
              }
            ]
            endPoint Solid {
              name "left_arm_solid"
              translation 0 0.11 0.10
              children [
                Transform {
                  translation 0 0 -0.13
                  children [
                    Shape {
                      appearance PBRAppearance {
                        baseColor 0.42 0.43 0.45
                      }
                      geometry Box {
                        size 0.05 0.05 0.26
                      }
                    }
                  ]
                }
              ]
              boundingObject Transform {
                translation 0 0 -0.13
                children [
                  Box {
                    size 0.05 0.05 0.26
                  }
                ]
              }
              physics Physics {
                density -1
                mass 0.12
                centerOfMass [
                  0 0 -0.13
                ]
                inertiaMatrix [
                  9.0e-04 9.0e-04 1.2e-04
                  0 0 0
                ]
              }
            }
          }
          DEF RIGHT_ARM_JOINT HingeJoint {
            jointParameters HingeJointParameters {
              axis 0 1 0
              anchor 0 -0.11 0.10
              dampingConstant 10.0
            }
            device [
              RotationalMotor {
                name "right_arm"
                maxVelocity 1.0
                maxTorque 4.0
              }
              PositionSensor {
                name "right_arm_sensor"
              }
            ]
            endPoint Solid {
              name "right_arm_solid"
              translation 0 -0.11 0.10
              children [
                Transform {
                  translation 0 0 -0.13
                  children [
                    Shape {
                      appearance PBRAppearance {
                        baseColor 0.42 0.43 0.45
                      }
                      geometry Box {
                        size 0.05 0.05 0.26
                      }
                    }
                  ]
                }
              ]
              boundingObject Transform {
                translation 0 0 -0.13
                children [
                  Box {
                    size 0.05 0.05 0.26
                  }
                ]
              }
              physics Physics {
                density -1
                mass 0.12
                centerOfMass [
                  0 0 -0.13
                ]
                inertiaMatrix [
                  9.0e-04 9.0e-04 1.2e-04
                  0 0 0
                ]
              }
            }
          }
        ]
        boundingObject Box {
          size 0.17 0.14 0.34
        }
        physics Physics {
          density -1
          mass 0.75
          centerOfMass [
            0 0 0.04
          ]
          inertiaMatrix [
            7.0e-03 7.5e-03 3.5e-03
            0 0 0
          ]
        }
      }
    }
    # Yellow edge eyes sit over each stripe and look *along* it.
    # Aim pucks are ~2 m ahead — a near-floor look-at rolls the image 90
    # (up ≈ look). Overlay: L line / mid finish / R line. 64x64 = brain buffer.
    DEF LINE_CAM_L Camera {
      translation 0.30 0.65 0.12
      name "line_left"
      width 64
      height 64
      fieldOfView 1.2
      near 0.03
    }
    DEF LINE_CAM_R Camera {
      translation 0.30 -0.65 0.12
      name "line_right"
      width 64
      height 64
      fieldOfView 1.2
      near 0.03
    }
    DEF YELLOW_AIM_L Transform {
      translation 2.00 0.65 0.02
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.85 0.9
            roughness 0.35
            metalness 0
            emissiveColor 0 0.55 0.6
          }
          geometry Sphere {
            radius 0.025
            subdivision 3
          }
        }
      ]
    }
    DEF YELLOW_AIM_R Transform {
      translation 2.00 -0.65 0.02
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.85 0.9
            roughness 0.35
            metalness 0
            emissiveColor 0 0.55 0.6
          }
          geometry Sphere {
            radius 0.025
            subdivision 3
          }
        }
      ]
    }
    DEF YELLOW_BEAM_L Transform {
      translation 0.24 0.60 0.08
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.85 0.9
            roughness 0.4
            metalness 0
            emissiveColor 0 0.45 0.5
          }
          geometry Cylinder {
            radius 0.006
            height 0.70
            subdivision 8
          }
        }
      ]
    }
    DEF YELLOW_BEAM_R Transform {
      translation 0.24 -0.60 0.08
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.85 0.9
            roughness 0.4
            metalness 0
            emissiveColor 0 0.45 0.5
          }
          geometry Cylinder {
            radius 0.006
            height 0.70
            subdivision 8
          }
        }
      ]
    }
    # Look-down-ahead stereo. Identity Camera looks −Z (down). Do NOT store a
    # guessed pitch — the controller look-at's DEF LOOKDOWN_AIM_* every launch.
    DEF FINISH_CAM Camera {
      translation 0.10 0.04 0.32
      name "finish_cam"
      width 64
      height 40
      fieldOfView 0.9
      near 0.05
    }
    DEF FINISH_CAM_R Camera {
      translation 0.10 -0.04 0.32
      name "finish_cam_r"
      width 64
      height 40
      fieldOfView 0.9
      near 0.05
    }
    # Labeled overlays = same buffer the controller scores (Daniel sketch).
    DEF HUD_LEFT Display {
      name "hud_left"
      width 64
      height 64
    }
    DEF HUD_RED Display {
      name "hud_red"
      width 64
      height 40
    }
    DEF HUD_RIGHT Display {
      name "hud_right"
      width 64
      height 64
    }
    # Magenta aim pucks: 1 m forward on the floor. Body-relative. Not paint.
    DEF LOOKDOWN_AIM_L Transform {
      translation 1.0 0.04 0.03
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 1 0 1
            roughness 0.35
            metalness 0
            emissiveColor 0.85 0 0.85
          }
          geometry Sphere {
            radius 0.03
            subdivision 3
          }
        }
      ]
    }
    DEF LOOKDOWN_AIM_R Transform {
      translation 1.0 -0.04 0.03
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 1 0 1
            roughness 0.35
            metalness 0
            emissiveColor 0.85 0 0.85
          }
          geometry Sphere {
            radius 0.03
            subdivision 3
          }
        }
      ]
    }
    # Z / W forecast eyes — front of the body, looking at the 2 m wall
    # pucks (YELLOW_AIM). LINE_CAM_* stay identity. Controller look-at
    # + FOV wire every launch. Overlay: hud_z / hud_w.
    DEF FORECAST_CAM_Z Camera {
      translation 0.16 0.06 0.20
      rotation 0 0 1 0
      name "forecast_z"
      width 64
      height 64
      fieldOfView 1.2
      near 0.05
    }
    DEF FORECAST_CAM_W Camera {
      translation 0.16 -0.06 0.20
      rotation 0 0 1 0
      name "forecast_w"
      width 64
      height 64
      fieldOfView 1.2
      near 0.05
    }
    DEF FORECAST_AIM_Z Transform {
      translation 2.40 0.50 0.10
      children [
