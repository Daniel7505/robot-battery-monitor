#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Parquetry.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"

WorldInfo {
  basicTimeStep 8
  # Stiffer global solver helps cylinder-wheel floor contact stay continuous
  # (intermittent contact → GPS speed flicker + body crawl under slip).
  ERP 0.6
  CFM 1e-9
  coordinateSystem "ENU"
  contactProperties [
    # Drive hubs ↔ floor: sticky rubber-like (named materials on wheel solids)
    ContactProperties {
      material1 "drive_wheel"
      material2 "default"
      coulombFriction [
        80
      ]
      forceDependentSlip [
        0
      ]
      frictionRotation 1 1
      bounce 0
      softCFM 1e-6
      softERP 0.7
    }
    # Casters ↔ floor: support pitch/roll but barely resist slide (no scrub drag)
    ContactProperties {
      material1 "caster"
      material2 "default"
      coulombFriction [
        0.08
      ]
      forceDependentSlip [
        1
      ]
      bounce 0
      softCFM 1e-5
      softERP 0.5
    }
    # Fallback any-any (safety net)
    ContactProperties {
      coulombFriction [
        40
      ]
      forceDependentSlip [
        0
      ]
      bounce 0
      softCFM 1e-6
      softERP 0.6
    }
  ]
  info [
    "ButlerBot Neo — upright wheeled humanoid (abstract Unitree Neo proportions)"
    "Driven hip wheels + 4 catch casters; BNO085-class IMU pitch-hold (biped precursor)"
    "TRACK (ENU): start line x=0.0 m  finish line x=15.0 m  length=15.0 m  y lane |y|<=0.6"
    "GPS on robot reports world translation (same frame as these markers)"
  ]
}

DEF VIEWPOINT Viewpoint {
  # Sideline onlooker: robot's RIGHT (−Y), ~14 ft (4.3 m) out, eye height.
  # ENU identity looks −Z (down); +X rotation tilts toward +Y (at the bot).
  # Tracking Shot walks with him so we see the 15 m dash in profile.
  follow "ButlerBot"
  followType "Tracking Shot"
  followSmoothness 0.2
  # Daniel mouse-framed sideline 2026-08-12 — Tracking Shot keeps this offset
  orientation 0 0 1 1.56
  position 0.02270 -3.81863 0.81003
  fieldOfView 0.85
}

Background {
  skyColor 0.72 0.76 0.82
}

DirectionalLight {
  direction 0.35 -0.55 -1
  intensity 1.15
  castShadows TRUE
}

Floor {
  name "ground"
  size 200 200
  tileSize 1 1
  appearance Parquetry {
    type "chequered"
    colorOverride 0.55 0.56 0.58
  }
}

# =============================================================================
# One-lane test track (known length + known world GPS / pose coordinates)
# Coordinate system: ENU (x forward east, y north, z up)
# Start line:  x = 0.0 m   (robot spawn on this line, facing +x)
# Finish line: x = 15.0 m  (3× original 5 m lane for energy repeatability runs)
# Lane width:  |y| <= 0.6 m (paint edges)
# Distance start→finish along lane center: 15.0 m exactly
# Visual only: NO boundingObject on paint (must not block the robot)
# =============================================================================

# START line (green) — GPS (0.0, 0.0)
Transform {
  translation 0 0 0.015
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.85 0.25
        roughness 0.7
        metalness 0
        emissiveColor 0.05 0.2 0.05
      }
      geometry Box {
        size 0.08 1.4 0.02
      }
    }
  ]
}

# FINISH line (red) — GPS (15.0, 0.0)
Transform {
  translation 15 0 0.015
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.15 0.12
        roughness 0.7
        metalness 0
        emissiveColor 0.25 0.04 0.03
      }
      geometry Box {
        size 0.08 1.4 0.02
      }
    }
  ]
}

# Lane edges (center x=7.5, length 15.2 m)
Transform {
  translation 7.5 0.65 0.008
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.95 0.95 0.2
        roughness 0.8
        metalness 0
      }
      geometry Box {
        size 15.2 0.06 0.01
      }
    }
  ]
}
Transform {
  translation 7.5 -0.65 0.008
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.95 0.95 0.2
        roughness 0.8
        metalness 0
      }
      geometry Box {
        size 15.2 0.06 0.01
      }
    }
  ]
}

# Hash marks every 3 m (3, 6, 9, 12)
Transform {
  translation 3 0 0.01
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.9 0.95
        roughness 0.9
      }
      geometry Box {
        size 0.04 0.5 0.01
      }
    }
  ]
}
Transform {
  translation 6 0 0.01
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.9 0.95
        roughness 0.9
      }
      geometry Box {
        size 0.04 0.5 0.01
      }
    }
  ]
}
Transform {
  translation 9 0 0.01
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.9 0.95
        roughness 0.9
      }
      geometry Box {
        size 0.04 0.5 0.01
      }
    }
  ]
}
Transform {
  translation 12 0 0.01
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.9 0.95
        roughness 0.9
      }
      geometry Box {
        size 0.04 0.5 0.01
      }
    }
  ]
}

Robot {
  # Spawn ON the start line (x=0), lane center y=0, facing +x (toward finish)
  translation 0 0 0
  rotation 0 0 1 0
  name "ButlerBot"
  # Supervisor enables soft grip coupling (body vel ↔ wheel odo) for tire fidelity
  supervisor TRUE
  controller "butlerbot_controller"
  controllerArgs [
    "--dashboard-url=http://127.0.0.1:5000"
  ]
  customData "ButlerBot Neo — upright wheeled humanoid ~0.95m"
  children [
    DEF PELVIS_VIS Transform {
      translation 0 0 0.20
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.14 0.15 0.18
            roughness 0.45
            metalness 0.25
          }
          geometry Box {
            size 0.18 0.11 0.07
          }
        }
      ]
    }
    DEF LEFT_WHEEL_JOINT HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0.17 0.08
        # Low viscous damping for free-roll traction. High damping (was 6.5) forced
        # τ≈damping*ω through the tire contact every step → continuous slip
        # (body GPS crawl while encoders held 5.5 rad/s). Residual spin after turns
        # is killed by ABS hard-zero / dual-hub lock, not joint viscous drag.
        dampingConstant 0.15
      }
      device [
        RotationalMotor {
          name "left_wheel"
          maxVelocity 15
          # Pololu 37D 50:1 stall ≈ 2.06 N·m; slight margin for ABS hold
          maxTorque 2.5
        }
        PositionSensor {
          name "left_wheel_sensor"
        }
      ]
      endPoint Solid {
        name "left_wheel_solid"
        translation 0 0.17 0.08
        contactMaterial "drive_wheel"
        children [
          Pose {
            rotation 1 0 0 1.5708
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.08 0.08 0.1
                }
                geometry Cylinder {
                  height 0.05
                  radius 0.08
                }
              }
            ]
          }
        ]
        # ENU Cylinder stands on Z (can / puck). Hinge is Y. Same 90° about X
        # on visual AND collision so the axle rolls. 4.5 rotated the Shape only.
        boundingObject Pose {
          rotation 1 0 0 1.5708
          children [
            Cylinder {
              height 0.05
              radius 0.08
            }
          ]
        }
        physics Physics {
          density -1
          # 80 mm rubber tire+hub ≈ 0.085 kg (profile geometry.wheel_mass_kg)
          mass 0.085
          centerOfMass [
            0 0 0
          ]
          inertiaMatrix [
            1.4e-04 2.7e-04 1.4e-04
            0 0 0
          ]
        }
      }
    }
    DEF RIGHT_WHEEL_JOINT HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 -0.17 0.08
        dampingConstant 0.15
      }
      device [
        RotationalMotor {
          name "right_wheel"
          maxVelocity 15
          maxTorque 2.5
        }
        PositionSensor {
          name "right_wheel_sensor"
        }
      ]
      endPoint Solid {
        name "right_wheel_solid"
        translation 0 -0.17 0.08
        contactMaterial "drive_wheel"
        children [
          Pose {
            rotation 1 0 0 1.5708
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.08 0.08 0.1
                }
                geometry Cylinder {
                  height 0.05
                  radius 0.08
                }
              }
            ]
          }
        ]
        # ENU Cylinder stands on Z (can / puck). Hinge is Y. Same 90° about X
        # on visual AND collision so the axle rolls. 4.5 rotated the Shape only.
        boundingObject Pose {
          rotation 1 0 0 1.5708
          children [
            Cylinder {
              height 0.05
              radius 0.08
            }
          ]
        }
        physics Physics {
          density -1
          mass 0.085
          centerOfMass [
            0 0 0
          ]
          inertiaMatrix [
            1.4e-04 2.7e-04 1.4e-04
            0 0 0
          ]
        }
      }
    }
    # Catch spheres. subdivision 4 = smoother contact (2 was a faceted bump).
    # z=0.044 → bottom ~4 mm above wheel contact. At 0.04 they fight the hubs.
    DEF FRONT_LEFT_CASTER BallJoint {
      jointParameters BallJointParameters {
        anchor 0.11 0.13 0.044
        dampingConstant 0.8
      }
      endPoint Solid {
        name "front_left_caster"
        translation 0.11 0.13 0.044
        contactMaterial "caster"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.22 0.22 0.25
              roughness 0.55
            }
            geometry Sphere {
              radius 0.04
              subdivision 4
            }
          }
        ]
        boundingObject Sphere {
          radius 0.04
          subdivision 4
        }
        physics Physics {
          density -1
          mass 0.06
        }
      }
    }
    DEF FRONT_RIGHT_CASTER BallJoint {
      jointParameters BallJointParameters {
        anchor 0.11 -0.13 0.044
        dampingConstant 0.8
      }
      endPoint Solid {
        name "front_right_caster"
        translation 0.11 -0.13 0.044
        contactMaterial "caster"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.22 0.22 0.25
              roughness 0.55
            }
            geometry Sphere {
              radius 0.04
              subdivision 4
            }
          }
        ]
        boundingObject Sphere {
          radius 0.04
          subdivision 4
        }
        physics Physics {
          density -1
          mass 0.06
        }
      }
    }
    DEF REAR_LEFT_CASTER BallJoint {
      jointParameters BallJointParameters {
        anchor -0.11 0.13 0.044
        dampingConstant 0.8
      }
      endPoint Solid {
        name "rear_left_caster"
        translation -0.11 0.13 0.044
        contactMaterial "caster"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.22 0.22 0.25
              roughness 0.55
            }
            geometry Sphere {
              radius 0.04
              subdivision 4
            }
          }
        ]
        boundingObject Sphere {
          radius 0.04
          subdivision 4
        }
        physics Physics {
          density -1
          mass 0.06
        }
      }
    }
    DEF REAR_RIGHT_CASTER BallJoint {
      jointParameters BallJointParameters {
        anchor -0.11 -0.13 0.044
        dampingConstant 0.8
      }
      endPoint Solid {
        name "rear_right_caster"
        translation -0.11 -0.13 0.044
        contactMaterial "caster"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.22 0.22 0.25
              roughness 0.55
            }
            geometry Sphere {
              radius 0.04
              subdivision 4
            }
          }
        ]
        boundingObject Sphere {
          radius 0.04
          subdivision 4
        }
        physics Physics {
          density -1
          mass 0.06
        }
      }
    }

    DEF TORSO_JOINT HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0 0.24
        dampingConstant 18.0
      }
      device [
        RotationalMotor {
          name "torso_joint"
          maxVelocity 0.7
          maxTorque 6.0
        }
        PositionSensor {
          name "torso_sensor"
        }
      ]
      endPoint Solid {
        name "torso_solid"
        translation 0 0 0.24
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.2 0.34 0.48
              roughness 0.5
              metalness 0.15
            }
            geometry Box {
              size 0.17 0.14 0.34
            }
          }
          Transform {
            translation 0 0.12 0.08
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.38 0.39 0.42
                }
                geometry Box {
                  size 0.05 0.05 0.04
                }
              }
            ]
          }
          Transform {
            translation 0 -0.12 0.08
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.38 0.39 0.42
                }
                geometry Box {
                  size 0.05 0.05 0.04
                }
              }
            ]
          }
          DEF NECK_VIS Transform {
            translation 0 0 0.20
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.18 0.2 0.24
                }
                geometry Cylinder {
                  height 0.06
                  radius 0.035
                }
              }
            ]
          }
          DEF HEAD_VIS Transform {
            translation 0 0 0.38
            children [
              GPS {
                name "gps_head"
                accuracy 0
                resolution -1
              }
              Shape {
                appearance PBRAppearance {
                  baseColor 0.16 0.18 0.22
                  roughness 0.35
                  metalness 0.2
                }
                geometry Sphere {
                  radius 0.065
                }
              }
              Transform {
                translation 0 0.065 0.01
                rotation 0 0 1 0
                children [
                  Shape {
                    appearance PBRAppearance {
                      baseColor 0.05 0.55 0.75
                      emissiveColor 0.02 0.15 0.22
                    }
                    geometry Box {
                      size 0.025 0.07 0.03
                    }
                  }
                ]
              }
            ]
          }
          DEF LEFT_ARM_JOINT HingeJoint {
            jointParameters HingeJointParameters {
              axis 0 1 0
              anchor 0 0.11 0.10
              dampingConstant 10.0
            }
            device [
              RotationalMotor {
                name "left_arm"
                maxVelocity 1.0
                maxTorque 4.0
              }
              PositionSensor {
                name "left_arm_sensor"
              }
            ]
            endPoint Solid {
              name "left_arm_solid"
              translation 0 0.11 0.10
              children [
                Transform {
                  translation 0 0 -0.13
                  children [
                    Shape {
                      appearance PBRAppearance {
                        baseColor 0.42 0.43 0.45
                      }
                      geometry Box {
                        size 0.05 0.05 0.26
                      }
                    }
                  ]
                }
              ]
              boundingObject Transform {
                translation 0 0 -0.13
                children [
                  Box {
                    size 0.05 0.05 0.26
                  }
                ]
              }
              physics Physics {
                density -1
                mass 0.12
                centerOfMass [
                  0 0 -0.13
                ]
                inertiaMatrix [
                  9.0e-04 9.0e-04 1.2e-04
                  0 0 0
                ]
              }
            }
          }
          DEF RIGHT_ARM_JOINT HingeJoint {
            jointParameters HingeJointParameters {
              axis 0 1 0
              anchor 0 -0.11 0.10
              dampingConstant 10.0
            }
            device [
              RotationalMotor {
                name "right_arm"
                maxVelocity 1.0
                maxTorque 4.0
              }
              PositionSensor {
                name "right_arm_sensor"
              }
            ]
            endPoint Solid {
              name "right_arm_solid"
              translation 0 -0.11 0.10
              children [
                Transform {
                  translation 0 0 -0.13
                  children [
                    Shape {
                      appearance PBRAppearance {
                        baseColor 0.42 0.43 0.45
                      }
                      geometry Box {
                        size 0.05 0.05 0.26
                      }
                    }
                  ]
                }
              ]
              boundingObject Transform {
                translation 0 0 -0.13
                children [
                  Box {
                    size 0.05 0.05 0.26
                  }
                ]
              }
              physics Physics {
                density -1
                mass 0.12
                centerOfMass [
                  0 0 -0.13
                ]
                inertiaMatrix [
                  9.0e-04 9.0e-04 1.2e-04
                  0 0 0
                ]
              }
            }
          }
        ]
        boundingObject Box {
          size 0.17 0.14 0.34
        }
        physics Physics {
          density -1
          mass 0.75
          centerOfMass [
            0 0 0.04
          ]
          inertiaMatrix [
            7.0e-03 7.5e-03 3.5e-03
            0 0 0
          ]
        }
      }
    }
    # Down-look eyes for the yellow edges (y=±0.65). Wide FOV so each
    # camera sees its stripe when the body is near lane center.
    Camera {
      translation 0.08 0.55 0.12
      name "line_left"
      width 8
      height 8
      fieldOfView 1.4
      near 0.03
    }
    Camera {
      translation 0.08 -0.55 0.12
      name "line_right"
      width 8
      height 8
      fieldOfView 1.4
      near 0.03
    }
    # Wide stereo pair (nav-cam class). Looks forward+down so a thin floor
    # mark on *this* track or a future one can still fill a few pixels.
    # Paint stays as-is — the eyes adapt, not the world.
    Camera {
      translation 0.10 0.04 0.32
      rotation 0 1 0 -1.32
      name "finish_cam"
      width 64
      height 40
      fieldOfView 1.2
      near 0.05
    }
    Camera {
      translation 0.10 -0.04 0.32
      rotation 0 1 0 -1.32
      name "finish_cam_r"
      width 64
      height 40
      fieldOfView 1.2
      near 0.05
    }
    GPS {
      name "gps"
      accuracy 0
      resolution -1
    }
    InertialUnit {
      name "imu"
    }
  ]
  physics Physics {
    density -1
    # Chassis class mass from hardware profile (geometry.chassis_mass_kg ≈ 3.2)
    mass 3.2
    centerOfMass [
      0 0 0.12
    ]
    inertiaMatrix [
      0.055 0.062 0.078
      0 0 0
    ]
  }
}