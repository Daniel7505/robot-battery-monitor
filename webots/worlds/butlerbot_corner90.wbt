#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Parquetry.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "../protos/ButlerBot.proto"

WorldInfo {
  basicTimeStep 8
  # Stiffer global solver helps cylinder-wheel floor contact stay continuous
  # (intermittent contact → GPS speed flicker + body crawl under slip).
  ERP 0.6
  CFM 1e-9
  coordinateSystem "ENU"
  contactProperties [
    # Drive hubs ↔ floor: sticky rubber-like (named materials on wheel solids)
    ContactProperties {
      material1 "drive_wheel"
      material2 "default"
      # μ=80 + frictionRotation 1 1 + no slip made yaw impossible:
      # motors commanded 3.2/1.0, both hubs sat at ~1.9, heading 0.
      coulombFriction [
        8
      ]
      forceDependentSlip [
        0.01
      ]
      frictionRotation 0 0
      bounce 0
      softCFM 1e-6
      softERP 0.7
    }
    # Casters ↔ floor: support pitch/roll but barely resist slide (no scrub drag)
    ContactProperties {
      material1 "caster"
      material2 "default"
      coulombFriction [
        0.08
      ]
      forceDependentSlip [
        1
      ]
      bounce 0
      softCFM 1e-5
      softERP 0.5
    }
    # Fallback any-any (safety net)
    ContactProperties {
      coulombFriction [
        40
      ]
      forceDependentSlip [
        0
      ]
      bounce 0
      softCFM 1e-6
      softERP 0.6
    }
  ]
  info [
    "ButlerBot Neo — upright wheeled humanoid (abstract Unitree Neo proportions)"
    "Driven hip wheels + 4 catch casters; BNO085-class IMU pitch-hold (biped precursor)"
    "TRACK (ENU): corner90  start (0,0)  finish (4,4)  lane 1.30 m  file tracks/corner90.json"
    "GPS on robot reports world translation (same frame as these markers)"
  ]
}

DEF VIEWPOINT Viewpoint {
  # Behind-and-up chase. Daniel mouse-framed 2026-08-16.
  follow "ButlerBot"
  followType "Tracking Shot"
  followSmoothness 0.2
  orientation -0.001250 0.999989 0.004550 0.536256
  position -3.18573 -0.03020 3.54536
  fieldOfView 0.85
}

Background {
  skyColor 0.72 0.76 0.82
}

DirectionalLight {
  direction 0.35 -0.55 -1
  intensity 1.0
  castShadows TRUE
}
# Fill from the opposite side so the right-hand stripe is not in shadow.
DirectionalLight {
  direction -0.25 0.55 -1
  intensity 0.45
  castShadows FALSE
}

Floor {
  name "ground"
  size 200 200
  tileSize 1 1
  appearance Parquetry {
    type "chequered"
    colorOverride 0.55 0.56 0.58
  }
}

# =============================================================================
# Track corner90 (visual only - no boundingObject)
# Hallway corner: 4 m straight, SHARP 90 deg left (true right angle), 4 m straight to the finish.
# Start (0,0)  finish (4,4)  centreline 8.00 m
# Lane width 1.30 m  stripe 6 cm  corners: 1 sharp, 0 rounded
# TRACK_FILE tracks/corner90.json
# Generated by python scripts/track_builder.py tracks/corner90.json --world <this world>.
# One DEF TRACK Pose; each painted part is ONE Shape / IndexedFaceSet (top,
# walls, end caps; two-sided via walls). Lines top 0.013, ticks 0.015, bars
# 0.025 above the floor. Do not hand-edit: change the track file and regenerate.
# =============================================================================
DEF TRACK Pose {
  children [
    # Left lane line (yellow, 6 cm): centreline offset +0.65 m, top z 0.013; one continuous ribbon along the offset curve
    DEF TRACK_LINE_L Shape {
      appearance PBRAppearance {
        baseColor 0.95 0.95 0.2
        roughness 0.8
        metalness 0
      }
      geometry IndexedFaceSet {
        coord Coordinate {
          point [
            -0.3 0.68 0.013, -0.3 0.62 0.013, -0.3 0.68 0.003, -0.3 0.62 0.003
            0 0.68 0.013, 0 0.62 0.013, 0 0.68 0.003, 0 0.62 0.003
            3.32 0.68 0.013, 3.38 0.62 0.013, 3.32 0.68 0.003, 3.38 0.62 0.003
            3.32 4 0.013, 3.38 4 0.013, 3.32 4 0.003, 3.38 4 0.003
            3.32 4.5 0.013, 3.38 4.5 0.013, 3.32 4.5 0.003, 3.38 4.5 0.003
          ]
        }
        coordIndex [
          1 5 4 0 -1 0 4 6 2 -1 1 3 7 5 -1 5 9 8 4 -1 4 8 10 6 -1 5 7 11 9 -1
          9 13 12 8 -1 8 12 14 10 -1 9 11 15 13 -1 13 17 16 12 -1 12 16 18 14 -1 13 15 19 17 -1
          2 3 1 0 -1 16 17 19 18 -1
        ]
        ccw TRUE
      }
    }
    # Right lane line (yellow, 6 cm): centreline offset -0.65 m, top z 0.013; one continuous ribbon along the offset curve
    DEF TRACK_LINE_R Shape {
      appearance PBRAppearance {
        baseColor 0.95 0.95 0.2
        roughness 0.8
        metalness 0
      }
      geometry IndexedFaceSet {
        coord Coordinate {
          point [
            -0.3 -0.62 0.013, -0.3 -0.68 0.013, -0.3 -0.62 0.003, -0.3 -0.68 0.003
            0 -0.62 0.013, 0 -0.68 0.013, 0 -0.62 0.003, 0 -0.68 0.003
            4.62 -0.62 0.013, 4.68 -0.68 0.013, 4.62 -0.62 0.003, 4.68 -0.68 0.003
            4.62 4 0.013, 4.68 4 0.013, 4.62 4 0.003, 4.68 4 0.003
            4.62 4.5 0.013, 4.68 4.5 0.013, 4.62 4.5 0.003, 4.68 4.5 0.003
          ]
        }
        coordIndex [
          1 5 4 0 -1 0 4 6 2 -1 1 3 7 5 -1 5 9 8 4 -1 4 8 10 6 -1 5 7 11 9 -1
          9 13 12 8 -1 8 12 14 10 -1 9 11 15 13 -1 13 17 16 12 -1 12 16 18 14 -1 13 15 19 17 -1
          2 3 1 0 -1 16 17 19 18 -1
        ]
        ccw TRUE
      }
    }
    # START line (green) at (0, 0)
    DEF TRACK_START Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.85 0.25
        roughness 0.7
        metalness 0
        emissiveColor 0.05 0.2 0.05
      }
      geometry IndexedFaceSet {
        coord Coordinate {
          point [
            -0.04 0.7 0.025, -0.04 -0.7 0.025, -0.04 0.7 0.005, -0.04 -0.7 0.005
            0.04 0.7 0.025, 0.04 -0.7 0.025, 0.04 0.7 0.005, 0.04 -0.7 0.005
          ]
        }
        coordIndex [
          1 5 4 0 -1 0 4 6 2 -1 1 3 7 5 -1 2 3 1 0 -1 4 5 7 6 -1
        ]
        ccw TRUE
      }
    }
    # FINISH line (red) - GPS at (4, 4)
    DEF TRACK_FINISH Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.15 0.12
        roughness 0.7
        metalness 0
        emissiveColor 0.25 0.04 0.03
      }
      geometry IndexedFaceSet {
        coord Coordinate {
          point [
            3.3 3.96 0.025, 4.7 3.96 0.025, 3.3 3.96 0.005, 4.7 3.96 0.005
            3.3 4.04 0.025, 4.7 4.04 0.025, 3.3 4.04 0.005, 4.7 4.04 0.005
          ]
        }
        coordIndex [
          1 5 4 0 -1 0 4 6 2 -1 1 3 7 5 -1 2 3 1 0 -1 4 5 7 6 -1
        ]
        ccw TRUE
      }
    }
  ]
}

ButlerBot {
  # Spawn ON the start line (x=0), lane center y=0, facing +x (toward finish)
  translation 0 0 0
  rotation 0 0 1 0
  name "ButlerBot"
  controller "butlerbot_controller"
  controllerArgs [
    "--dashboard-url=http://127.0.0.1:5000"
  ]
}