          321 325 324 320 -1 320 324 326 322 -1 321 323 327 325 -1 325 329 328 324 -1 324 328 330 326 -1 325 327 331 329 -1
          329 333 332 328 -1 328 332 334 330 -1 329 331 335 333 -1 333 337 336 332 -1 332 336 338 334 -1 333 335 339 337 -1
