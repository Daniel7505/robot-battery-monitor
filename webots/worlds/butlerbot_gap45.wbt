#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Parquetry.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "../protos/ButlerBot.proto"

WorldInfo {
  basicTimeStep 8
  # Stiffer global solver helps cylinder-wheel floor contact stay continuous
  # (intermittent contact → GPS speed flicker + body crawl under slip).
  ERP 0.6
  CFM 1e-9
  coordinateSystem "ENU"
  contactProperties [
    # Drive hubs ↔ floor: sticky rubber-like (named materials on wheel solids)
    ContactProperties {
      material1 "drive_wheel"
      material2 "default"
      # μ=80 + frictionRotation 1 1 + no slip made yaw impossible:
      # motors commanded 3.2/1.0, both hubs sat at ~1.9, heading 0.
      coulombFriction [
        8
      ]
      forceDependentSlip [
        0.01
      ]
      frictionRotation 0 0
      bounce 0
      softCFM 1e-6
      softERP 0.7
    }
    # Casters ↔ floor: support pitch/roll but barely resist slide (no scrub drag)
    ContactProperties {
      material1 "caster"
      material2 "default"
      coulombFriction [
        0.08
      ]
      forceDependentSlip [
        1
      ]
      bounce 0
      softCFM 1e-5
      softERP 0.5
    }
    # Fallback any-any (safety net)
    ContactProperties {
      coulombFriction [
        40
      ]
      forceDependentSlip [
        0
      ]
      bounce 0
      softCFM 1e-6
      softERP 0.6
    }
  ]
  info [
    "ButlerBot Neo — upright wheeled humanoid (abstract Unitree Neo proportions)"
    "Driven hip wheels + 4 catch casters; BNO085-class IMU pitch-hold (biped precursor)"
    "TRACK (ENU): gap45  start (0,0)  exits east  file tracks/gap45.json"
    "GPS on robot reports world translation (same frame as these markers)"
  ]
}

DEF VIEWPOINT Viewpoint {
  # Behind-and-up chase. Daniel mouse-framed 2026-08-16.
  follow "ButlerBot"
  followType "Tracking Shot"
  followSmoothness 0.2
  orientation -0.001250 0.999989 0.004550 0.536256
  position -3.18573 -0.03020 3.54536
  fieldOfView 0.85
}

Background {
  skyColor 0.72 0.76 0.82
}

DirectionalLight {
  direction 0.35 -0.55 -1
  intensity 1.0
  castShadows TRUE
}
# Fill from the opposite side so the right-hand stripe is not in shadow.
DirectionalLight {
  direction -0.25 0.55 -1
  intensity 0.45
  castShadows FALSE
}

Floor {
  name "ground"
  size 200 200
  tileSize 1 1
  appearance Parquetry {
    type "chequered"
    colorOverride 0.55 0.56 0.58
  }
}

# =============================================================================
# Track gap45 (visual only - no boundingObject)
# Large crossing: 4 m, then a 4.5 m wide crossing road (a plaza: the lane lines stop for 4.5 m; the far side is beyond the 1.96 m camera reach when the gap is wider than that), 4 m more. Dan's large-intersection / limited look-ahead case.
# Start (0,0)  exits: east (12.5,0)
# Roads 2, lane widths 1.30/4.50 m, stripe 6 cm
# TRACK_FILE tracks/gap45.json
# Generated by python scripts/track_builder.py tracks/gap45.json --world <this world>.
# One DEF TRACK Pose; each painted part is ONE Shape / IndexedFaceSet (top,
# walls, end caps; two-sided via walls). Lines top 0.013, ticks 0.015, bars
# 0.025 above the floor. Do not hand-edit: change the track file and regenerate.
# =============================================================================
DEF TRACK Pose {
  children [
    # Lane lines (yellow, 6 cm) of 2 roads, 8 pieces: cut where another road joins; top z 0.013
    DEF TRACK_LINES Shape {
      appearance PBRAppearance {
        baseColor 0.95 0.95 0.2
        roughness 0.8
        metalness 0
      }
      geometry IndexedFaceSet {
        coord Coordinate {
          point [
            -0.3 0.68 0.013, -0.3 0.62 0.013, -0.3 0.68 0.003, -0.3 0.62 0.003
            4.02 0.68 0.013, 4.02 0.62 0.013, 4.02 0.68 0.003, 4.02 0.62 0.003
            8.48 0.68 0.013, 8.48 0.62 0.013, 8.48 0.68 0.003, 8.48 0.62 0.003
            13 0.68 0.013, 13 0.62 0.013, 13 0.68 0.003, 13 0.62 0.003
            -0.3 -0.62 0.013, -0.3 -0.68 0.013, -0.3 -0.62 0.003, -0.3 -0.68 0.003
            4.02 -0.62 0.013, 4.02 -0.68 0.013, 4.02 -0.62 0.003, 4.02 -0.68 0.003
            8.48 -0.62 0.013, 8.48 -0.68 0.013, 8.48 -0.62 0.003, 8.48 -0.68 0.003
            13 -0.62 0.013, 13 -0.68 0.013, 13 -0.62 0.003, 13 -0.68 0.003
            3.97 -4 0.013, 4.03 -4 0.013, 3.97 -4 0.003, 4.03 -4 0.003
            3.97 -0.62 0.013, 4.03 -0.62 0.013, 3.97 -0.62 0.003, 4.03 -0.62 0.003
            3.97 0.62 0.013, 4.03 0.62 0.013, 3.97 0.62 0.003, 4.03 0.62 0.003
            3.97 4 0.013, 4.03 4 0.013, 3.97 4 0.003, 4.03 4 0.003
            8.47 -4 0.013, 8.53 -4 0.013, 8.47 -4 0.003, 8.53 -4 0.003
            8.47 -0.62 0.013, 8.53 -0.62 0.013, 8.47 -0.62 0.003, 8.53 -0.62 0.003
            8.47 0.62 0.013, 8.53 0.62 0.013, 8.47 0.62 0.003, 8.53 0.62 0.003
            8.47 4 0.013, 8.53 4 0.013, 8.47 4 0.003, 8.53 4 0.003
          ]
        }
        coordIndex [
          1 5 4 0 -1 0 4 6 2 -1 1 3 7 5 -1 2 3 1 0 -1 4 5 7 6 -1 9 13 12 8 -1
          8 12 14 10 -1 9 11 15 13 -1 10 11 9 8 -1 12 13 15 14 -1 17 21 20 16 -1 16 20 22 18 -1
          17 19 23 21 -1 18 19 17 16 -1 20 21 23 22 -1 25 29 28 24 -1 24 28 30 26 -1 25 27 31 29 -1
          26 27 25 24 -1 28 29 31 30 -1 33 37 36 32 -1 32 36 38 34 -1 33 35 39 37 -1 34 35 33 32 -1
          36 37 39 38 -1 41 45 44 40 -1 40 44 46 42 -1 41 43 47 45 -1 42 43 41 40 -1 44 45 47 46 -1
          49 53 52 48 -1 48 52 54 50 -1 49 51 55 53 -1 50 51 49 48 -1 52 53 55 54 -1 57 61 60 56 -1
          56 60 62 58 -1 57 59 63 61 -1 58 59 57 56 -1 60 61 63 62 -1
        ]
        ccw TRUE
      }
    }
    # START line (green) at (0, 0)
    DEF TRACK_START Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.85 0.25
        roughness 0.7
        metalness 0
        emissiveColor 0.05 0.2 0.05
      }
      geometry IndexedFaceSet {
        coord Coordinate {
          point [
            -0.04 0.7 0.025, -0.04 -0.7 0.025, -0.04 0.7 0.005, -0.04 -0.7 0.005
            0.04 0.7 0.025, 0.04 -0.7 0.025, 0.04 0.7 0.005, 0.04 -0.7 0.005
          ]
        }
        coordIndex [
          1 5 4 0 -1 0 4 6 2 -1 1 3 7 5 -1 2 3 1 0 -1 4 5 7 6 -1
        ]
        ccw TRUE
      }
    }
    # EXIT east (red) - GPS finish at (12.5, 0)
    DEF TRACK_EXIT_EAST Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.15 0.12
        roughness 0.7
        metalness 0
        emissiveColor 0.25 0.04 0.03
      }
      geometry IndexedFaceSet {
        coord Coordinate {
          point [
            12.46 0.7 0.025, 12.46 -0.7 0.025, 12.46 0.7 0.005, 12.46 -0.7 0.005
            12.54 0.7 0.025, 12.54 -0.7 0.025, 12.54 0.7 0.005, 12.54 -0.7 0.005
          ]
        }
        coordIndex [
          1 5 4 0 -1 0 4 6 2 -1 1 3 7 5 -1 2 3 1 0 -1 4 5 7 6 -1
        ]
        ccw TRUE
      }
    }
  ]
}

ButlerBot {
  # Spawn ON the start line (x=0), lane center y=0, facing +x (toward finish)
  translation 0 0 0
  rotation 0 0 1 0
  name "ButlerBot"
  controller "butlerbot_controller"
  controllerArgs [
    "--dashboard-url=http://127.0.0.1:5000"
  ]
}