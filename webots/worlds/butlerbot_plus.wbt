#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Parquetry.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"

WorldInfo {
  basicTimeStep 8
  # Stiffer global solver helps cylinder-wheel floor contact stay continuous
  # (intermittent contact → GPS speed flicker + body crawl under slip).
  ERP 0.6
  CFM 1e-9
  coordinateSystem "ENU"
  contactProperties [
    # Drive hubs ↔ floor: sticky rubber-like (named materials on wheel solids)
    ContactProperties {
      material1 "drive_wheel"
      material2 "default"
      # μ=80 + frictionRotation 1 1 + no slip made yaw impossible:
      # motors commanded 3.2/1.0, both hubs sat at ~1.9, heading 0.
      coulombFriction [
        8
      ]
      forceDependentSlip [
        0.01
      ]
      frictionRotation 0 0
      bounce 0
      softCFM 1e-6
      softERP 0.7
    }
    # Casters ↔ floor: support pitch/roll but barely resist slide (no scrub drag)
    ContactProperties {
      material1 "caster"
      material2 "default"
      coulombFriction [
        0.08
      ]
      forceDependentSlip [
        1
      ]
      bounce 0
      softCFM 1e-5
      softERP 0.5
    }
    # Fallback any-any (safety net)
    ContactProperties {
      coulombFriction [
        40
      ]
      forceDependentSlip [
        0
      ]
      bounce 0
      softCFM 1e-6
      softERP 0.6
    }
  ]
  info [
    "ButlerBot Neo — upright wheeled humanoid (abstract Unitree Neo proportions)"
    "Driven hip wheels + 4 catch casters; BNO085-class IMU pitch-hold (biped precursor)"
    "TRACK (ENU): plus  start (0,0)  exits east south north  file tracks/plus.json"
    "GPS on robot reports world translation (same frame as these markers)"
  ]
}

DEF VIEWPOINT Viewpoint {
  # Behind-and-up chase. Daniel mouse-framed 2026-08-16.
  follow "ButlerBot"
  followType "Tracking Shot"
  followSmoothness 0.2
  orientation -0.001250 0.999989 0.004550 0.536256
  position -3.18573 -0.03020 3.54536
  fieldOfView 0.85
}

Background {
  skyColor 0.72 0.76 0.82
}

DirectionalLight {
  direction 0.35 -0.55 -1
  intensity 1.0
  castShadows TRUE
}
# Fill from the opposite side so the right-hand stripe is not in shadow.
DirectionalLight {
  direction -0.25 0.55 -1
  intensity 0.45
  castShadows FALSE
}

Floor {
  name "ground"
  size 200 200
  tileSize 1 1
  appearance Parquetry {
    type "chequered"
    colorOverride 0.55 0.56 0.58
  }
}

# =============================================================================
# Track plus (visual only - no boundingObject)
# Plus crossing: 4 m, a 1.30 m road crosses (lines have gaps where it joins), 4 m more. Exits east (straight), north (left), south (right).
# Start (0,0)  exits: east (8,0), south (4,-4), north (4,4)
# Roads 2, lane widths 1.30 m, stripe 6 cm
# TRACK_FILE tracks/plus.json
# Generated by python scripts/track_builder.py tracks/plus.json --world <this world>.
# One DEF TRACK Pose; each painted part is ONE Shape / IndexedFaceSet (top,
# walls, end caps; two-sided via walls). Lines top 0.013, ticks 0.015, bars
# 0.025 above the floor. Do not hand-edit: change the track file and regenerate.
# =============================================================================
DEF TRACK Pose {
  children [
    # Lane lines (yellow, 6 cm) of 2 roads, 8 pieces: cut where another road joins; top z 0.013
    DEF TRACK_LINES Shape {
      appearance PBRAppearance {
        baseColor 0.95 0.95 0.2
        roughness 0.8
        metalness 0
      }
      geometry IndexedFaceSet {
        coord Coordinate {
          point [
            -0.3 0.68 0.013, -0.3 0.62 0.013, -0.3 0.68 0.003, -0.3 0.62 0.003
            3.38 0.68 0.013, 3.38 0.62 0.013, 3.38 0.68 0.003, 3.38 0.62 0.003
            4.62 0.68 0.013, 4.62 0.62 0.013, 4.62 0.68 0.003, 4.62 0.62 0.003
            8.5 0.68 0.013, 8.5 0.62 0.013, 8.5 0.68 0.003, 8.5 0.62 0.003
            -0.3 -0.62 0.013, -0.3 -0.68 0.013, -0.3 -0.62 0.003, -0.3 -0.68 0.003
            3.38 -0.62 0.013, 3.38 -0.68 0.013, 3.38 -0.62 0.003, 3.38 -0.68 0.003
            4.62 -0.62 0.013, 4.62 -0.68 0.013, 4.62 -0.62 0.003, 4.62 -0.68 0.003
            8.5 -0.62 0.013, 8.5 -0.68 0.013, 8.5 -0.62 0.003, 8.5 -0.68 0.003
            3.32 -4.5 0.013, 3.38 -4.5 0.013, 3.32 -4.5 0.003, 3.38 -4.5 0.003
            3.32 -0.62 0.013, 3.38 -0.62 0.013, 3.32 -0.62 0.003, 3.38 -0.62 0.003
            3.32 0.62 0.013, 3.38 0.62 0.013, 3.32 0.62 0.003, 3.38 0.62 0.003
            3.32 4.5 0.013, 3.38 4.5 0.013, 3.32 4.5 0.003, 3.38 4.5 0.003
            4.62 -4.5 0.013, 4.68 -4.5 0.013, 4.62 -4.5 0.003, 4.68 -4.5 0.003
            4.62 -0.62 0.013, 4.68 -0.62 0.013, 4.62 -0.62 0.003, 4.68 -0.62 0.003
            4.62 0.62 0.013, 4.68 0.62 0.013, 4.62 0.62 0.003, 4.68 0.62 0.003
            4.62 4.5 0.013, 4.68 4.5 0.013, 4.62 4.5 0.003, 4.68 4.5 0.003
          ]
        }
        coordIndex [
          1 5 4 0 -1 0 4 6 2 -1 1 3 7 5 -1 2 3 1 0 -1 4 5 7 6 -1 9 13 12 8 -1
          8 12 14 10 -1 9 11 15 13 -1 10 11 9 8 -1 12 13 15 14 -1 17 21 20 16 -1 16 20 22 18 -1
          17 19 23 21 -1 18 19 17 16 -1 20 21 23 22 -1 25 29 28 24 -1 24 28 30 26 -1 25 27 31 29 -1
          26 27 25 24 -1 28 29 31 30 -1 33 37 36 32 -1 32 36 38 34 -1 33 35 39 37 -1 34 35 33 32 -1
          36 37 39 38 -1 41 45 44 40 -1 40 44 46 42 -1 41 43 47 45 -1 42 43 41 40 -1 44 45 47 46 -1
          49 53 52 48 -1 48 52 54 50 -1 49 51 55 53 -1 50 51 49 48 -1 52 53 55 54 -1 57 61 60 56 -1
          56 60 62 58 -1 57 59 63 61 -1 58 59 57 56 -1 60 61 63 62 -1
        ]
        ccw TRUE
      }
    }
    # START line (green) at (0, 0)
    DEF TRACK_START Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.85 0.25
        roughness 0.7
        metalness 0
        emissiveColor 0.05 0.2 0.05
      }
      geometry IndexedFaceSet {
        coord Coordinate {
          point [
            -0.04 0.7 0.025, -0.04 -0.7 0.025, -0.04 0.7 0.005, -0.04 -0.7 0.005
            0.04 0.7 0.025, 0.04 -0.7 0.025, 0.04 0.7 0.005, 0.04 -0.7 0.005
          ]
        }
        coordIndex [
          1 5 4 0 -1 0 4 6 2 -1 1 3 7 5 -1 2 3 1 0 -1 4 5 7 6 -1
        ]
        ccw TRUE
      }
    }
    # EXIT east (red) - GPS finish at (8, 0)
    DEF TRACK_EXIT_EAST Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.15 0.12
        roughness 0.7
        metalness 0
        emissiveColor 0.25 0.04 0.03
      }
      geometry IndexedFaceSet {
        coord Coordinate {
          point [
            7.96 0.7 0.025, 7.96 -0.7 0.025, 7.96 0.7 0.005, 7.96 -0.7 0.005
            8.04 0.7 0.025, 8.04 -0.7 0.025, 8.04 0.7 0.005, 8.04 -0.7 0.005
          ]
        }
        coordIndex [
          1 5 4 0 -1 0 4 6 2 -1 1 3 7 5 -1 2 3 1 0 -1 4 5 7 6 -1
        ]
        ccw TRUE
      }
    }
    # EXIT south (red) - GPS finish at (4, -4)
    DEF TRACK_EXIT_SOUTH Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.15 0.12
        roughness 0.7
        metalness 0
        emissiveColor 0.25 0.04 0.03
      }
      geometry IndexedFaceSet {
        coord Coordinate {
          point [
            4.7 -3.96 0.025, 3.3 -3.96 0.025, 4.7 -3.96 0.005, 3.3 -3.96 0.005
            4.7 -4.04 0.025, 3.3 -4.04 0.025, 4.7 -4.04 0.005, 3.3 -4.04 0.005
          ]
        }
        coordIndex [
          1 5 4 0 -1 0 4 6 2 -1 1 3 7 5 -1 2 3 1 0 -1 4 5 7 6 -1
        ]
        ccw TRUE
      }
    }
    # EXIT north (red) - GPS finish at (4, 4)
    DEF TRACK_EXIT_NORTH Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.15 0.12
        roughness 0.7
        metalness 0
        emissiveColor 0.25 0.04 0.03
      }
      geometry IndexedFaceSet {
        coord Coordinate {
          point [
            3.3 3.96 0.025, 4.7 3.96 0.025, 3.3 3.96 0.005, 4.7 3.96 0.005
            3.3 4.04 0.025, 4.7 4.04 0.025, 3.3 4.04 0.005, 4.7 4.04 0.005
          ]
        }
        coordIndex [
          1 5 4 0 -1 0 4 6 2 -1 1 3 7 5 -1 2 3 1 0 -1 4 5 7 6 -1
        ]
        ccw TRUE
      }
    }
  ]
}

Robot {
  # Spawn ON the start line (x=0), lane center y=0, facing +x (toward finish)
  translation 0 0 0
  rotation 0 0 1 0
  name "ButlerBot"
  # Supervisor enables soft grip coupling (body vel ↔ wheel odo) for tire fidelity
  supervisor TRUE
  controller "butlerbot_controller"
  controllerArgs [
    "--dashboard-url=http://127.0.0.1:5000"
  ]
  customData "ButlerBot Neo — upright wheeled humanoid ~0.95m"
  children [
    DEF PELVIS_VIS Transform {
      translation 0 0 0.20
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.14 0.15 0.18
            roughness 0.45
            metalness 0.25
          }
          geometry Box {
            size 0.18 0.11 0.07
          }
        }
      ]
    }
    DEF LEFT_WHEEL_JOINT HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0.17 0.08
        # Low viscous damping for free-roll traction. High damping (was 6.5) forced
        # τ≈damping*ω through the tire contact every step → continuous slip
        # (body GPS crawl while encoders held 5.5 rad/s). Residual spin after turns
        # is killed by ABS hard-zero / dual-hub lock, not joint viscous drag.
        dampingConstant 0.15
      }
      device [
        RotationalMotor {
          name "left_wheel"
          maxVelocity 15
          # Pololu 37D 50:1 stall ≈ 2.06 N·m; slight margin for ABS hold
          maxTorque 2.5
        }
        PositionSensor {
          name "left_wheel_sensor"
        }
      ]
      endPoint Solid {
        name "left_wheel_solid"
        translation 0 0.17 0.08
        contactMaterial "drive_wheel"
        children [
          Pose {
            rotation 1 0 0 1.5708
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.08 0.08 0.1
                }
                geometry Cylinder {
                  height 0.05
                  radius 0.08
                }
              }
            ]
          }
        ]
        # ENU Cylinder stands on Z (can / puck). Hinge is Y. Same 90° about X
        # on visual AND collision so the axle rolls. 4.5 rotated the Shape only.
        boundingObject Pose {
          rotation 1 0 0 1.5708
          children [
            Cylinder {
              height 0.05
              radius 0.08
            }
          ]
        }
        physics Physics {
          density -1
          # 80 mm rubber tire+hub ≈ 0.085 kg (profile geometry.wheel_mass_kg)
          mass 0.085
          centerOfMass [
            0 0 0
          ]
          inertiaMatrix [
            1.4e-04 2.7e-04 1.4e-04
            0 0 0
          ]
        }
      }
    }
    DEF RIGHT_WHEEL_JOINT HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 -0.17 0.08
        dampingConstant 0.15
      }
      device [
        RotationalMotor {
          name "right_wheel"
          maxVelocity 15
          maxTorque 2.5
        }
        PositionSensor {
          name "right_wheel_sensor"
        }
      ]
      endPoint Solid {
        name "right_wheel_solid"
        translation 0 -0.17 0.08
        contactMaterial "drive_wheel"
        children [
          Pose {
            rotation 1 0 0 1.5708
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.08 0.08 0.1
                }
                geometry Cylinder {
                  height 0.05
                  radius 0.08
                }
              }
            ]
          }
        ]
        # ENU Cylinder stands on Z (can / puck). Hinge is Y. Same 90° about X
        # on visual AND collision so the axle rolls. 4.5 rotated the Shape only.
        boundingObject Pose {
          rotation 1 0 0 1.5708
          children [
            Cylinder {
              height 0.05
              radius 0.08
            }
          ]
        }
        physics Physics {
          density -1
          mass 0.085
          centerOfMass [
            0 0 0
          ]
          inertiaMatrix [
            1.4e-04 2.7e-04 1.4e-04
            0 0 0
          ]
        }
      }
    }
    # Catch spheres. subdivision 4 = smoother contact (2 was a faceted bump).
    # z=0.044 → bottom ~4 mm above wheel contact. At 0.04 they fight the hubs.
    DEF FRONT_LEFT_CASTER BallJoint {
      jointParameters BallJointParameters {
        anchor 0.11 0.13 0.044
        dampingConstant 0.8
      }
      endPoint Solid {
        name "front_left_caster"
        translation 0.11 0.13 0.044
        contactMaterial "caster"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.22 0.22 0.25
              roughness 0.55
            }
            geometry Sphere {
              radius 0.04
              subdivision 4
            }
          }
        ]
        boundingObject Sphere {
          radius 0.04
          subdivision 4
        }
        physics Physics {
          density -1
          mass 0.06
        }
      }
    }
    DEF FRONT_RIGHT_CASTER BallJoint {
      jointParameters BallJointParameters {
        anchor 0.11 -0.13 0.044
        dampingConstant 0.8
      }
      endPoint Solid {
        name "front_right_caster"
        translation 0.11 -0.13 0.044
        contactMaterial "caster"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.22 0.22 0.25
              roughness 0.55
            }
            geometry Sphere {
              radius 0.04
              subdivision 4
            }
          }
        ]
        boundingObject Sphere {
          radius 0.04
          subdivision 4
        }
        physics Physics {
          density -1
          mass 0.06
        }
      }
    }
    DEF REAR_LEFT_CASTER BallJoint {
      jointParameters BallJointParameters {
        anchor -0.11 0.13 0.044
        dampingConstant 0.8
      }
      endPoint Solid {
        name "rear_left_caster"
        translation -0.11 0.13 0.044
        contactMaterial "caster"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.22 0.22 0.25
              roughness 0.55
            }
            geometry Sphere {
              radius 0.04
              subdivision 4
            }
          }
        ]
        boundingObject Sphere {
          radius 0.04
          subdivision 4
        }
        physics Physics {
          density -1
          mass 0.06
        }
      }
    }
    DEF REAR_RIGHT_CASTER BallJoint {
      jointParameters BallJointParameters {
        anchor -0.11 -0.13 0.044
        dampingConstant 0.8
      }
      endPoint Solid {
        name "rear_right_caster"
        translation -0.11 -0.13 0.044
        contactMaterial "caster"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.22 0.22 0.25
              roughness 0.55
            }
            geometry Sphere {
              radius 0.04
              subdivision 4
            }
          }
        ]
        boundingObject Sphere {
          radius 0.04
          subdivision 4
        }
        physics Physics {
          density -1
          mass 0.06
        }
      }
    }

    DEF TORSO_JOINT HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0 0.24
        dampingConstant 18.0
      }
      device [
        RotationalMotor {
          name "torso_joint"
          maxVelocity 0.7
          maxTorque 6.0
        }
        PositionSensor {
          name "torso_sensor"
        }
      ]
      endPoint Solid {
        name "torso_solid"
        translation 0 0 0.24
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.2 0.34 0.48
              roughness 0.5
              metalness 0.15
            }
            geometry Box {
              size 0.17 0.14 0.34
            }
          }
          Transform {
            translation 0 0.12 0.08
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.38 0.39 0.42
                }
                geometry Box {
                  size 0.05 0.05 0.04
                }
              }
            ]
          }
          Transform {
            translation 0 -0.12 0.08
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.38 0.39 0.42
                }
                geometry Box {
                  size 0.05 0.05 0.04
                }
              }
            ]
          }
          DEF NECK_VIS Transform {
            translation 0 0 0.20
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.18 0.2 0.24
                }
                geometry Cylinder {
                  height 0.06
                  radius 0.035
                }
              }
            ]
          }
          DEF HEAD_VIS Transform {
            translation 0 0 0.38
            children [
              GPS {
                name "gps_head"
                accuracy 0
                resolution -1
              }
              Shape {
                appearance PBRAppearance {
                  baseColor 0.16 0.18 0.22
                  roughness 0.35
                  metalness 0.2
                }
                geometry Sphere {
                  radius 0.065
                }
              }
              Transform {
                translation 0 0.065 0.01
                rotation 0 0 1 0
                children [
                  Shape {
                    appearance PBRAppearance {
                      baseColor 0.05 0.55 0.75
                      emissiveColor 0.02 0.15 0.22
                    }
                    geometry Box {
                      size 0.025 0.07 0.03
                    }
                  }
                ]
              }
            ]
          }
          DEF LEFT_ARM_JOINT HingeJoint {
            jointParameters HingeJointParameters {
              axis 0 1 0
              anchor 0 0.11 0.10
              dampingConstant 10.0
            }
            device [
              RotationalMotor {
                name "left_arm"
                maxVelocity 1.0
                maxTorque 4.0
              }
              PositionSensor {
                name "left_arm_sensor"
              }
            ]
            endPoint Solid {
              name "left_arm_solid"
              translation 0 0.11 0.10
              children [
                Transform {
                  translation 0 0 -0.13
                  children [
                    Shape {
                      appearance PBRAppearance {
                        baseColor 0.42 0.43 0.45
                      }
                      geometry Box {
                        size 0.05 0.05 0.26
                      }
                    }
                  ]
                }
              ]
              boundingObject Transform {
                translation 0 0 -0.13
                children [
                  Box {
                    size 0.05 0.05 0.26
                  }
                ]
              }
              physics Physics {
                density -1
                mass 0.12
                centerOfMass [
                  0 0 -0.13
                ]
                inertiaMatrix [
                  9.0e-04 9.0e-04 1.2e-04
                  0 0 0
                ]
              }
            }
          }
          DEF RIGHT_ARM_JOINT HingeJoint {
            jointParameters HingeJointParameters {
              axis 0 1 0
              anchor 0 -0.11 0.10
              dampingConstant 10.0
            }
            device [
              RotationalMotor {
                name "right_arm"
                maxVelocity 1.0
                maxTorque 4.0
              }
              PositionSensor {
                name "right_arm_sensor"
              }
            ]
            endPoint Solid {
              name "right_arm_solid"
              translation 0 -0.11 0.10
              children [
                Transform {
                  translation 0 0 -0.13
                  children [
                    Shape {
                      appearance PBRAppearance {
                        baseColor 0.42 0.43 0.45
                      }
                      geometry Box {
                        size 0.05 0.05 0.26
                      }
                    }
                  ]
                }
              ]
              boundingObject Transform {
                translation 0 0 -0.13
                children [
                  Box {
                    size 0.05 0.05 0.26
                  }
                ]
              }
              physics Physics {
                density -1
                mass 0.12
                centerOfMass [
                  0 0 -0.13
                ]
                inertiaMatrix [
                  9.0e-04 9.0e-04 1.2e-04
                  0 0 0
                ]
              }
            }
          }
        ]
        boundingObject Box {
          size 0.17 0.14 0.34
        }
        physics Physics {
          density -1
          mass 0.75
          centerOfMass [
            0 0 0.04
          ]
          inertiaMatrix [
            7.0e-03 7.5e-03 3.5e-03
            0 0 0
          ]
        }
      }
    }
    # Shoulder nadirs only. LINE / SIDE / FINISH / Z/W and aim pucks
    # archived at archives/butlerbot_choir_2026-09-02.wbt.
    # Left shoulder. Boom + box from Daniel's 2026-08-25 framing (DUMP_CAM,
    # VIEWPOINT COPY position 0.01042 0.41808 0.72919). Since 2026-10-01
    # NADIR_CAM_L sits in this box (front-bottom edge), see the Camera node.
    DEF NADIR_BOOM_L Transform {
      translation 0.00521 0.26904 0.57460
      rotation 1 0 0 -0.767
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.08 0.08 0.1
            roughness 0.45
          }
          geometry Cylinder {
            height 0.43
            radius 0.012
            subdivision 8
          }
        }
      ]
    }
    DEF NADIR_BOX_L Transform {
      translation 0.01042 0.41808 0.72919
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.12 0.12 0.14
            roughness 0.4
          }
          geometry Box {
            size 0.05 0.05 0.05
          }
        }
      ]
    }
    DEF NADIR_CAM_L Camera {
      # Lens on the front-bottom edge of NADIR_BOX_L (box centre
      # 0.01042 0.41808 0.72919, 0.05 m cube): the box is behind/above the
      # lens, so no ray can see its inside. Pure pitch 0 1 0 0.9411 rad
      # (53.9 deg down) from scripts/aim_camera.py: top row -> 1.96 m ahead
      # of the axle (same reach as the old z 1.31 mount), bottom row
      # ~0.06 m ahead. Controller reads this pose live (Supervisor).
      # Keep a direct Robot child. Do not File-Save.
      translation 0.03542 0.41808 0.70419
      rotation 0 1 0 0.9411
      name "nadir_left"
      width 128
      height 128
      fieldOfView 1.2
      near 0.03
    }
    # Right shoulder: Y-mirror of the left boom/box/camera.
    DEF NADIR_BOOM_R Transform {
      translation 0.00521 -0.26904 0.57460
      rotation 1 0 0 0.767
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.08 0.08 0.1
            roughness 0.45
          }
          geometry Cylinder {
            height 0.43
            radius 0.012
            subdivision 8
          }
        }
      ]
    }
    DEF NADIR_BOX_R Transform {
      translation 0.01042 -0.41808 0.72919
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.12 0.12 0.14
            roughness 0.4
          }
          geometry Box {
            size 0.05 0.05 0.05
          }
        }
      ]
    }
    DEF NADIR_CAM_R Camera {
      # True Y-mirror of NADIR_CAM_L: translation y negated, same pure
      # pitch (0 1 0 theta is mirror-symmetric). Front-bottom edge of NADIR_BOX_R.
      translation 0.03542 -0.41808 0.70419
      rotation 0 1 0 0.9411
      name "nadir_right"
      width 128
      height 128
      fieldOfView 1.2
      near 0.03
    }
    # Shoulder HUDs only.
    DEF HUD_NADIR Display {
      name "hud_nadir"
      width 256
      height 256
    }
    DEF HUD_NADIR_R Display {
      name "hud_nadir_r"
      width 256
      height 256
    }
    GPS {
      name "gps"
      accuracy 0
      resolution -1
    }
    InertialUnit {
      name "imu"
    }
  ]
  # Physics with no boundingObject is ignored by Webots. Pelvis box sits
  # above the tires so it does not fight the floor.
  boundingObject Pose {
    translation 0 0 0.20
    children [
      Box {
        size 0.18 0.11 0.07
      }
    ]
  }
  physics Physics {
    density -1
    # Chassis class mass from hardware profile (geometry.chassis_mass_kg ≈ 3.2)
    mass 3.2
    centerOfMass [
      0 0 0.12
    ]
    inertiaMatrix [
      0.055 0.062 0.078
      0 0 0
    ]
  }
}