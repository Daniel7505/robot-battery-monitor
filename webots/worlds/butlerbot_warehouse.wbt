#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Parquetry.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"

WorldInfo {
  basicTimeStep 8
  # Stiffer global solver helps cylinder-wheel floor contact stay continuous
  # (intermittent contact → GPS speed flicker + body crawl under slip).
  ERP 0.6
  CFM 1e-9
  coordinateSystem "ENU"
  contactProperties [
    # Drive hubs ↔ floor: sticky rubber-like (named materials on wheel solids)
    ContactProperties {
      material1 "drive_wheel"
      material2 "default"
      # μ=80 + frictionRotation 1 1 + no slip made yaw impossible:
      # motors commanded 3.2/1.0, both hubs sat at ~1.9, heading 0.
      coulombFriction [
        8
      ]
      forceDependentSlip [
        0.01
      ]
      frictionRotation 0 0
      bounce 0
      softCFM 1e-6
      softERP 0.7
    }
    # Casters ↔ floor: support pitch/roll but barely resist slide (no scrub drag)
    ContactProperties {
      material1 "caster"
      material2 "default"
      coulombFriction [
        0.08
      ]
      forceDependentSlip [
        1
      ]
      bounce 0
      softCFM 1e-5
      softERP 0.5
    }
    # Fallback any-any (safety net)
    ContactProperties {
      coulombFriction [
        40
      ]
      forceDependentSlip [
        0
      ]
      bounce 0
      softCFM 1e-6
      softERP 0.6
    }
  ]
  info [
    "ButlerBot Neo — upright wheeled humanoid (abstract Unitree Neo proportions)"
    "Driven hip wheels + 4 catch casters; BNO085-class IMU pitch-hold (biped precursor)"
    "TRACK (ENU): warehouse  start (0,0)  exits receiving_2 shipping_2 shipping_1  file tracks/warehouse.json"
    "WAREHOUSE: 70 x 65 m prototype, start inside receiving door RCV-1, RBM_ROUTE per junction (see tracks/warehouse.json missions)"
    "GPS on robot reports world translation (same frame as these markers)"
  ]
}

DEF VIEWPOINT Viewpoint {
  # Warehouse TOP-DOWN FOLLOW cam: straight down over ButlerBot from 48.5 m (walls 9 m, racks 6 m), ~30 m of floor across the window.
  # Tracking Shot = follows the robot's translation only, so the map never rotates:
  # dock wall at the bottom, +x (into the building) up, +y left, same as the preview.
  # Derived from WarehouseSpec by scripts/warehouse_builder.py follow_viewpoint(); the controller
  # keeps this pose (re-centred on the robot) instead of the 3.2 m chase. No roof / ceiling.
  follow "ButlerBot"
  followType "Tracking Shot"
  followSmoothness 0.2
  orientation 0 1 0 1.5708
  position 0 0 48.4909
  fieldOfView 0.6
  near 0.48
  far 194
}

Background {
  skyColor 0.72 0.76 0.82
}

# Warehouse: no shadows (6 m racks would throw the aisles into hard shadow; indoor light is diffuse).
DirectionalLight {
  direction 0.35 -0.55 -1
  intensity 1.0
  castShadows FALSE
}
# Fill from the opposite side so the right-hand stripe is not in shadow.
DirectionalLight {
  direction -0.25 0.55 -1
  intensity 0.45
  castShadows FALSE
}

# Warehouse floor = building footprint (same appearance as the test worlds: the lane vision was
# tuned on it). Walls at x -4..61, y -17..53.
Floor {
  translation 28.5 18 0
  name "ground"
  size 65 70
  tileSize 1 1
  appearance Parquetry {
    type "chequered"
    colorOverride 0.55 0.56 0.58
  }
}

# -----------------------------------------------------------------------------
# WAREHOUSE_BEGIN
# Prototype warehouse 70 x 65 m (4550 m2, 48,976 sq ft). Generated by scripts/warehouse_builder.py - do not hand-edit.
