    # Shoulder nadirs only. LINE / SIDE / FINISH / Z/W and aim pucks
    # archived at archives/butlerbot_choir_2026-09-02.wbt.
    # Left shoulder. Boom + box from Daniel's 2026-08-25 framing (DUMP_CAM,
    # VIEWPOINT COPY position 0.01042 0.41808 0.72919). Since 2026-10-01
    # NADIR_CAM_L sits in this box (front-bottom edge), see the Camera node.
    DEF NADIR_BOOM_L Transform {
      translation 0.00521 0.26904 0.57460
      rotation 1 0 0 -0.767
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.08 0.08 0.1
            roughness 0.45
          }
          geometry Cylinder {
            height 0.43
            radius 0.012
            subdivision 8
          }
        }
      ]
    }
    DEF NADIR_BOX_L Transform {
      translation 0.01042 0.41808 0.72919
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.12 0.12 0.14
            roughness 0.4
          }
          geometry Box {
            size 0.05 0.05 0.05
          }
        }
      ]
    }
    DEF NADIR_CAM_L Camera {
      # Lens on the front-bottom edge of NADIR_BOX_L (box centre
      # 0.01042 0.41808 0.72919, 0.05 m cube): the box is behind/above the
      # lens, so no ray can see its inside. Pure pitch 0 1 0 0.9411 rad
      # (53.9 deg down) from scripts/aim_camera.py: top row -> 1.96 m ahead
      # of the axle (same reach as the old z 1.31 mount), bottom row
      # ~0.06 m ahead. Controller reads this pose live (Supervisor).
      # Keep a direct Robot child. Do not File-Save.
      translation 0.03542 0.41808 0.70419
      rotation 0 1 0 0.9411
      name "nadir_left"
      width 128
      height 128
      fieldOfView 1.2
      near 0.03
    }
    # Right shoulder: Y-mirror of the left boom/box/camera.
    DEF NADIR_BOOM_R Transform {
      translation 0.00521 -0.26904 0.57460
      rotation 1 0 0 0.767
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.08 0.08 0.1
            roughness 0.45
          }
          geometry Cylinder {
            height 0.43
            radius 0.012
            subdivision 8
          }
        }
      ]
    }
    DEF NADIR_BOX_R Transform {
      translation 0.01042 -0.41808 0.72919
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.12 0.12 0.14
            roughness 0.4
          }
          geometry Box {
            size 0.05 0.05 0.05
          }
        }
      ]
    }
    DEF NADIR_CAM_R Camera {
      # True Y-mirror of NADIR_CAM_L: translation y negated, same pure
      # pitch (0 1 0 theta is mirror-symmetric). Front-bottom edge of NADIR_BOX_R.
      translation 0.03542 -0.41808 0.70419
      rotation 0 1 0 0.9411
      name "nadir_right"
      width 128
      height 128
      fieldOfView 1.2
      near 0.03
    }
    # Forward STEREO pair for obstacles (docs/OBSTACLES.md). Mast and bar are
    # visuals only (no boundingObject, no mass: physics unchanged). Lenses on the
    # front face of STEREO_BAR: baseline 0.10 m (y +-0.05), z 0.78 m,
    # pure pitch 0 1 0 0.3469 (19.9 deg down) from src/stereo_depth.py
    # stereo_pitch_for_top(): the top row reaches 1.0 m height 1.0 m ahead of the
    # lenses, the floor is seen from 0.75 m ahead of the axle. Identical rotations,
    # baseline along the camera y axis = already rectified. Direct Robot children
    # (the torso hinge does not tilt them). The controller reads the live pose
    # (Supervisor) and only enables them when RBM_OBSTACLES is on. Do not File-Save.
    DEF STEREO_MAST Transform {
      translation 0.115 0 0.49
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.08 0.08 0.1
            roughness 0.45
          }
          geometry Cylinder {
            height 0.56
            radius 0.01
            subdivision 8
          }
        }
      ]
    }
    DEF STEREO_BAR Transform {
      translation 0.12 0 0.78
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.12 0.12 0.14
            roughness 0.4
          }
          geometry Box {
            size 0.03 0.16 0.03
          }
        }
      ]
    }
    DEF STEREO_CAM_L Camera {
      translation 0.14 0.05 0.78
      rotation 0 1 0 0.3469
      name "stereo_left"
      width 320
      height 240
      fieldOfView 1.4
      near 0.05
    }
    # Right lens: Y-mirror of STEREO_CAM_L (same pure pitch).
    DEF STEREO_CAM_R Camera {
      translation 0.14 -0.05 0.78
      rotation 0 1 0 0.3469
      name "stereo_right"
      width 320
      height 240
      fieldOfView 1.4
      near 0.05
    }
    # Forward radar (docs/OBSTACLES.md): moving objects in the lane corridor.
    # Looks along -Z; rotation 0 1 0 pi/2 aims it along robot +x. Height 0.45 m
    # (bumper / cart-radar height) so a rolling ball and a pallet face both return.
    # Ranges / FOV sized for the stereo corridor (~±0.54 m half-width out to 8 m).
    DEF RADAR_FWD Radar {
      translation 0.16 0 0.45
      rotation 0 1 0 1.5708
      name "radar_fwd"
      minRange 0.15
      maxRange 8
      horizontalFieldOfView 1.0
      verticalFieldOfView 0.7
      minAbsoluteRadialSpeed 0
      minRadialSpeed 0
      maxRadialSpeed 0
      occlusion TRUE
      antennaGain 20
      frequency 77
      transmittedPower 10
      minDetectableSignal -90
    }
    # Shoulder HUDs only.
    DEF HUD_NADIR Display {
      name "hud_nadir"
      width 256
      height 256
    }
    DEF HUD_NADIR_R Display {
      name "hud_nadir_r"
      width 256
      height 256
    }
    GPS {
      name "gps"
      accuracy 0
      resolution -1
    }
    InertialUnit {
      name "imu"
    }
  ]
  # Physics with no boundingObject is ignored by Webots. Pelvis box sits
  # above the tires so it does not fight the floor.
  boundingObject Pose {
    translation 0 0 0.20
    children [
      Box {
        size 0.18 0.11 0.07
      }
    ]
  }
  physics Physics {
    density -1
    # Chassis class mass from hardware profile (geometry.chassis_mass_kg ≈ 3.2)
    mass 3.2
    centerOfMass [
      0 0 0.12
    ]
    inertiaMatrix [
      0.055 0.062 0.078
      0 0 0
    ]
  }
}